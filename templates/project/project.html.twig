{% extends 'base.html.twig' %}

{% block title %}{{ project.name }}{% endblock %}

{% block page_title %}
   <div class="flex-header">
      <h1>{{ project.name }}</h1>
         <div class="user-list">
            {% for employee in project.employees %}
               <div class="avatar">{{ employee.name|slice(0, 1)|upper }}{{ employee.firstname|slice(0, 1)|upper }}</div>
            {% endfor %}
         </div>
         <a class="button" href="{{ path('project_edit', { id: project.id }) }}">Modifier</a>
   </div>
{% endblock %}

{% block body %}
   <div id="tasks-container">

      <div class="task-column">
         <h2>To Do</h2>
         <div class="tasks-list">
         {% for task in project.tasks %}
            {% if task.status == 'todo' %}
               <a class="task" href="{{ path('task_edit', { id: task.id }) }}">
                  <h3>{{ task.name }}</h3>
                  <p>{{ task.description }}</p>
                  <div class="task-infos">
                     {% if task.deadline %}
                     <div class="task-deadline">
                        <i class="fa-regular fa-calendar"></i> {{ task.deadline|date('d/m/Y') }}
                     </div>
                     {% endif %}
                     {% if task.employees %}
                     <div class="mini-user">{{ task.employees.name|slice(0, 1)|upper }}{{ task.employees.firstname|slice(0, 1)|upper }}</div>
                     {% endif %}
                  </div>
               </a>
            {% endif %}
         {% endfor %}
         <a href="{{ path('task_add', { projectId: project.id }) }}" class="task-add">+ Ajouter une tâche</a>
         </div>
      </div>

      <div class="task-column">
         <h2>Doing</h2>
         <div class="tasks-list">
         {% for task in project.tasks %}
            {% if task.status == 'doing' %}
               <a class="task" href="{{ path('task_edit', { id: task.id }) }}">
                  <h3>{{ task.name }}</h3>
                  <p>{{ task.description }}</p>
                  <div class="task-infos">
                     {% if task.deadline %}
                     <div class="task-deadline">
                        <i class="fa-regular fa-calendar"></i> {{ task.deadline|date('d/m/Y') }}
                     </div>
                     {% endif %}
                     {% if task.employees %}
                     <div class="mini-user">{{ task.employees.name|slice(0, 1)|upper }}{{ task.employees.firstname|slice(0, 1)|upper }}</div>
                     {% endif %}
                  </div>
               </a>
            {% endif %}
         {% endfor %}
         <a href="{{ path('task_add', { projectId: project.id }) }}" class="task-add">+ Ajouter une tâche</a>
         </div>
      </div>

      <div class="task-column">
         <h2>Done</h2>
         <div class="tasks-list">
         {% for task in project.tasks %}
            {% if task.status == 'done' %}
               <a class="task" href="{{ path('task_edit', { id: task.id }) }}">
                  <h3>{{ task.name }}</h3>
                  <p>{{ task.description }}</p>
                  <div class="task-infos">
                     {% if task.deadline %}
                     <div class="task-deadline">
                        <i class="fa-regular fa-calendar"></i> {{ task.deadline|date('d/m/Y') }}
                     </div>
                     {% endif %}
                     {% if task.employees %}
                     <div class="mini-user">{{ task.employees.name|slice(0, 1)|upper }}{{ task.employees.firstname|slice(0, 1)|upper }}</div>
                     {% endif %}
                  </div>
               </a>
            {% endif %}
         {% endfor %}
         <a href="{{ path('task_add', { projectId: project.id }) }}" class="task-add">+ Ajouter une tâche</a>
         </div>
      </div>
   </div>
{% endblock %}

