{% extends 'base.html.twig' %}

{% block title %}{{ task.name }}{% endblock %}

{% block page_title %}
    {% if formTask is defined %}Modifier {{ task.name }}{% else %}{{ task.name }}{% endif %}
{% endblock %}

{% block body %}
    {% if formTask is defined %}
        {{ form_start(formTask) }}
            <div>{{ form_label(formTask.name) }}{{ form_widget(formTask.name) }}</div>
            <div>{{ form_label(formTask.description) }}{{ form_widget(formTask.description) }}</div>
            <div class="flex-form">
                <div>{{ form_label(formTask.deadline) }}{{ form_widget(formTask.deadline) }}</div>
                <div>{{ form_label(formTask.status) }}{{ form_widget(formTask.status) }}</div>
            </div>
            <div>{{ form_label(formTask.employees) }}{{ form_widget(formTask.employees) }}</div>
            <br>
            <button class="button button-submit">Modifier</button>
            <a href="{{ path('task_delete', { id: task.id }) }}" class="delete-task">Supprimer la tâche</a>
        {{ form_end(formTask) }}
    {% else %}
        <p>{{ task.description }}</p>
        {% if task.deadline %}<p><strong>Date :</strong> {{ task.deadline|date('d/m/Y') }}</p>{% endif %}
        <p><strong>Statut :</strong> {{ task.status }}</p>
        {% if task.employees %}<p><strong>Membre :</strong> {{ task.employees.firstname }} {{ task.employees.name }}</p>{% endif %}
        <a class="button" href="{{ path('task_edit', { id: task.id }) }}">Modifier</a>
    {% endif %}
{% endblock %}